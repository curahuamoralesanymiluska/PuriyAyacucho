<?xml version="1.0" encoding="utf-8"?>
<!-- Al tocar, la tarjeta se encoge un poquito (efecto "botón suave") -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="110" android:propertyName="scaleX" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="110" android:propertyName="scaleY" android:valueTo="0.95" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="180" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="180" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
