<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Vista AR de ARCore (SceneView) -->
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnArCerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/cd_close"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvArUbicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_green"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_red"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/arcore_badge"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Instrucciones -->
    <TextView
        android:id="@+id/tvArInstruccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_ar_instruccion"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/arcore_move_phone"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Tarjeta de información -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="140dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvArInfoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF3D5A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArInfoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Controles inferiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ar_controles"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ra_today"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ra_reconstruction"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ra_slider_cd"
            android:stepSize="1"
            android:value="70"
            android:valueFrom="0"
            android:valueTo="100"
            app:labelBehavior="gone"
            app:thumbColor="#FFFFFF"
            app:trackColorActive="#FF3D5A"
            app:trackColorInactive="#66FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnArNarracion"
                style="@style/RaBotonLateral">

                <ImageView
                    android:id="@+id/ivArNarracion"
                    style="@style/ArBotonIcono"
                    android:src="@drawable/ic_volume" />

                <TextView
                    style="@style/ArBotonTexto"
                    android:text="@string/ra_narration" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnArInfo"
                style="@style/RaBotonLateral">

                <ImageView
                    style="@style/ArBotonIcono"
                    android:src="@drawable/ic_place" />

                <TextView
                    style="@style/ArBotonTexto"
                    android:text="@string/arcore_info" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnArReiniciar"
                style="@style/RaBotonLateral">

                <ImageView
                    style="@style/ArBotonIcono"
                    android:src="@drawable/ic_refresh" />

                <TextView
                    style="@style/ArBotonTexto"
                    android:text="@string/arcore_reset" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnArIdioma"
                style="@style/RaBotonLateral">

                <TextView
                    android:id="@+id/tvArIdioma"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:gravity="center"
                    android:text="ES"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/ArBotonTexto"
                    android:text="@string/language" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnArModoSimple"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/arcore_simple_mode"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
