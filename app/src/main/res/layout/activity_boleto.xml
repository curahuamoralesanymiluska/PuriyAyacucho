<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/btnBoletoVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="#2D2D2D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/ticket_title"
                android:textColor="#2D2D2D"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Boleto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvBoletoTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:textColor="#F2FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBoletoEvento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBoletoLugar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textColor="#F2FFFFFF"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_place"
                        app:drawableTint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp">

                    <LinearLayout style="@style/BoletoDato">

                        <TextView
                            style="@style/BoletoDatoLabel"
                            android:text="@string/ticket_date" />

                        <TextView
                            android:id="@+id/tvBoletoFecha"
                            style="@style/BoletoDatoValor" />
                    </LinearLayout>

                    <LinearLayout style="@style/BoletoDato">

                        <TextView
                            style="@style/BoletoDatoLabel"
                            android:text="@string/ticket_time" />

                        <TextView
                            android:id="@+id/tvBoletoHora"
                            style="@style/BoletoDatoValor" />
                    </LinearLayout>

                    <LinearLayout style="@style/BoletoDato">

                        <TextView
                            style="@style/BoletoDatoLabel"
                            android:text="@string/ticket_entries" />

                        <TextView
                            android:id="@+id/tvBoletoEntradas"
                            style="@style/BoletoDatoValor" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Separador punteado con muescas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="-10dp"
                        android:background="@drawable/bg_notch" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="-10dp"
                        android:background="@drawable/bg_notch" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivBoletoQr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/ticket_qr_cd" />

                <TextView
                    android:id="@+id/tvBoletoCodigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="#999999"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/ticket_show_code"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Total pagado -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_total_paid"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBoletoTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D2D2D"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBoletoEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="@string/ticket_paid"
                    android:textColor="#2EAA4F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_check"
                    app:drawableTint="#2EAA4F" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarCalendario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.06"
            android:text="@string/ticket_add_calendar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#FF3D5A"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_calendar"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
