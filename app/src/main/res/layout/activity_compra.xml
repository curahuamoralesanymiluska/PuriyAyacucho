<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Cabecera del evento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_gradient_bg"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:id="@+id/btnCompraVolver"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_back"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvCompraTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:textColor="#F2FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompraNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompraInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tipo de entrada -->
            <TextView
                style="@style/GuiaSeccion"
                android:text="@string/purchase_ticket_type" />

            <RadioGroup
                android:id="@+id/rgTipoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:orientation="vertical" />

            <!-- Cantidad -->
            <TextView
                style="@style/GuiaSeccion"
                android:text="@string/purchase_quantity" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMenos"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_less"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FF3D5A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCantidad"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_more"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FF3D5A"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Resumen -->
            <TextView
                style="@style/GuiaSeccion"
                android:text="@string/purchase_summary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/FilaResumen">

                        <TextView
                            android:id="@+id/tvResumenEntradasLabel"
                            style="@style/FilaResumenLabel" />

                        <TextView
                            android:id="@+id/tvResumenSubtotal"
                            style="@style/FilaResumenValor" />
                    </LinearLayout>

                    <LinearLayout style="@style/FilaResumen">

                        <TextView
                            android:id="@+id/tvResumenComisionLabel"
                            style="@style/FilaResumenLabel" />

                        <TextView
                            android:id="@+id/tvResumenComision"
                            style="@style/FilaResumenValor" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#F0F0F0" />

                    <LinearLayout style="@style/FilaResumen">

                        <TextView
                            style="@style/FilaResumenLabel"
                            android:text="@string/purchase_total"
                            android:textColor="#2D2D2D"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResumenTotal"
                            style="@style/FilaResumenValor"
                            android:textColor="#2D2D2D"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_aviso"
                android:padding="10dp"
                android:text="@string/purchase_demo_notice"
                android:textColor="#B45309"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPagar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:letterSpacing="0.06"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#FF3D5A"
        app:cornerRadius="14dp" />

    <ProgressBar
        android:id="@+id/progressPago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />
</LinearLayout>
