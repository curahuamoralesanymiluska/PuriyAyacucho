<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Cabecera con degradado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_gradient_bg"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="64dp">

            <ImageView
                android:id="@+id/btnGuiaVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/guide_title"
                android:textColor="#F2FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guide_question"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Desde / Hacia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-44dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_dot_origin" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guide_from"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvGuiaOrigen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guide_main_square"
                            android:textColor="#2D2D2D"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnGuiaMiUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="@string/guide_use_my_location"
                        android:textColor="#FF3D5A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="24dp"
                    android:background="#F0F0F0" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGuiaDestino"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/guide_to"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FF3D5A"
                    app:hintTextColor="#FF3D5A"
                    app:startIconDrawable="@drawable/ic_place"
                    app:startIconTint="#FF3D5A">

                    <AutoCompleteTextView
                        android:id="@+id/actvGuiaDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:inputType="text"
                        android:padding="14dp"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ¿Cómo te moverás? -->
        <TextView
            style="@style/GuiaSeccion"
            android:text="@string/guide_how_move" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            app:checkedButton="@+id/btnModoTransporte"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoTransporte"
                style="@style/GuiaModoBoton"
                android:text="@string/mode_transport"
                app:icon="@drawable/ic_bus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoPie"
                style="@style/GuiaModoBoton"
                android:text="@string/mode_walk"
                app:icon="@drawable/ic_walk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoTaxi"
                style="@style/GuiaModoBoton"
                android:text="@string/mode_taxi"
                app:icon="@drawable/ic_taxi" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Mostrar cerca de la ruta -->
        <TextView
            style="@style/GuiaSeccion"
            android:text="@string/guide_show_near" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCercaRestaurantes"
                    style="@style/GuiaSwitch"
                    android:checked="true"
                    android:text="@string/guide_near_restaurants" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCercaHospedaje"
                    style="@style/GuiaSwitch"
                    android:checked="true"
                    android:text="@string/guide_near_lodging" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCercaCultura"
                    style="@style/GuiaSwitch"
                    android:text="@string/guide_near_culture" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCercaBares"
                    style="@style/GuiaSwitch"
                    android:text="@string/guide_near_bars" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerarRecorrido"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.06"
            android:text="@string/guide_generate"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#FF3D5A"
            app:cornerRadius="14dp" />

        <!-- Rutas populares -->
        <TextView
            style="@style/GuiaSeccion"
            android:text="@string/guide_popular_routes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRutaIglesias"
                style="@style/GuiaRutaPopular">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/route_churches"
                        android:textColor="#2D2D2D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/route_churches_info"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRutaWari"
                style="@style/GuiaRutaPopular">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/route_wari_quinua"
                        android:textColor="#2D2D2D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/route_wari_quinua_info"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/btnMisRecorridos"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/my_routes"
            android:textColor="#FF3D5A"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
