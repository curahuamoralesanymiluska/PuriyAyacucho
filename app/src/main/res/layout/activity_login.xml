<?xml version="1.0" encoding="utf-8"?>
<!-- Login: arriba el logo sobre el rosa de Puriy, abajo una hoja blanca con el formulario -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_fondo"
    tools:context=".LoginActivity">

    <!-- Burbujas decorativas -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-120dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/bg_burbuja" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_burbuja" />

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Logo -->
            <LinearLayout
                android:id="@+id/headerLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="26dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.04"
                    android:text="@string/login_subtitle"
                    android:textColor="#F2FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Hoja blanca con el formulario -->
            <LinearLayout
                android:id="@+id/hojaLogin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_hoja"
                android:elevation="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="26dp"
                android:paddingTop="28dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_welcome"
                    android:textColor="#1D1D27"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/login_sheet_subtitle"
                    android:textColor="#8A8A99"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/CampoLogin"
                    android:layout_marginTop="22dp"
                    android:hint="@string/email_hint"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        style="@style/CampoLoginTexto"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/CampoLogin"
                    android:layout_marginTop="12dp"
                    android:hint="@string/password_hint"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#8A8A99"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/CampoLoginTexto"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvOlvideContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="@string/login_forgot_password"
                    android:textColor="#FF3355"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_boton_degradado"
                    android:elevation="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@animator/presionar_suave"
                    android:text="@string/btn_login"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Separador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#ECECF2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="@string/continue_with"
                        android:textColor="#A5A5B4"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#ECECF2" />
                </LinearLayout>

                <!-- Google y Facebook con el mismo estilo (blancos, sin el azul) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleLogin"
                        style="@style/BotonSocial"
                        android:layout_marginEnd="6dp"
                        android:text="@string/google"
                        app:icon="@drawable/ic_google"
                        app:iconTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFacebookLogin"
                        style="@style/BotonSocial"
                        android:layout_marginStart="6dp"
                        android:text="@string/facebook"
                        app:icon="@drawable/ic_facebook"
                        app:iconTint="#FF3355" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="12dp" />

                <TextView
                    android:id="@+id/tvGuestLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="@string/login_as_guest"
                    android:textColor="#4D4D5C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_persona"
                    app:drawableTint="#8A8A99" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_account"
                        android:textColor="#8A8A99"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGoToRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="@string/register_here"
                        android:textColor="#FF3355"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
