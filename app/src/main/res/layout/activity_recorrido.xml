<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Mapa con la ruta -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapRecorrido"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnRecorridoVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="14dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/cd_back"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="#2D2D2D" />

        <TextView
            android:id="@+id/tvRecorridoTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="18dp"
            android:background="@drawable/bg_pill_white"
            android:drawablePadding="6dp"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="#2D2D2D"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_clock"
            app:drawableTint="#FF3D5A" />

        <!-- Leyenda: qué significa cada color de línea -->
        <LinearLayout
            android:id="@+id/layoutLeyendaRuta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="34dp"
            android:background="@drawable/bg_pill_white"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvLeyendaCaminar"
                style="@style/LeyendaRuta"
                android:text="@string/legend_walk"
                app:drawableTint="#1E88E5" />

            <TextView
                android:id="@+id/tvLeyendaCombi"
                style="@style/LeyendaRuta"
                android:text="@string/legend_bus"
                app:drawableTint="#FF7A18" />

            <TextView
                android:id="@+id/tvLeyendaTaxi"
                style="@style/LeyendaRuta"
                android:text="@string/legend_taxi"
                app:drawableTint="#FFB300" />
        </LinearLayout>

        <!-- Crédito de los datos de calles (solo cuando la ruta sigue las calles) -->
        <TextView
            android:id="@+id/tvCreditoCalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="38dp"
            android:background="@drawable/bg_pill_white"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/route_osm_credit"
            android:textColor="#8A8A99"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Hoja inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-22dp"
        android:layout_weight="0.55"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_your_trip_to"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRecorridoDestino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_estimated_fare"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRecorridoTarifa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecorridoAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_aviso"
            android:padding="10dp"
            android:text="@string/route_no_transport"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:tabIndicatorColor="#FF3D5A"
            app:tabSelectedTextColor="#FF3D5A"
            app:tabTextAppearance="@style/CustomTabText"
            app:tabTextColor="#757575" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPasos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="12dp" />

            <LinearLayout
                android:id="@+id/layoutCercanos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_add_stops_hint"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCercanos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSinCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/route_no_nearby"
                    android:textColor="#999999"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarRecorrido"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="@string/route_start"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#FF3355"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
