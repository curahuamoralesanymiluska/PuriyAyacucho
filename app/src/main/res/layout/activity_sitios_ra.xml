<?xml version="1.0" encoding="utf-8"?>
<!-- "Viaja al pasado": lista de sitios con Realidad Aumentada -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FB"
    android:orientation="vertical">

    <!-- Cabecera nocturna -->
    <LinearLayout
        android:id="@+id/headerSitiosRA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ra_banner"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp">

        <ImageView
            android:id="@+id/btnSitiosRAVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="@string/ar_banner_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:text="@string/ar_sites_subtitle"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />

        <!-- Cómo funciona, en 3 pasos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/RaPasoPildora"
                android:text="@string/ar_how_step1" />

            <TextView
                style="@style/RaPasoPildora"
                android:layout_marginHorizontal="6dp"
                android:text="@string/ar_how_step2" />

            <TextView
                style="@style/RaPasoPildora"
                android:text="@string/ar_how_step3" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSitiosRA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/entrada_cuadricula"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_sitio_ra" />
</LinearLayout>
