<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de filtros que aparece encima del RecyclerView al elegir un modulo filtrable -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/barraFiltros"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Fila superior: contador + boton Filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvContadorLugares"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 lugares"
            android:textColor="@color/puriy_tinta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirFiltros"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Filtros"
                android:textColor="@color/puriy_tinta"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_filtros"
                app:iconSize="16dp"
                app:iconTint="@color/puriy_tinta"
                app:strokeColor="@color/puriy_borde"
                app:strokeWidth="1dp" />

            <!-- Burbuja con numero de filtros activos -->
            <TextView
                android:id="@+id/tvBurbujaFiltros"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                android:background="@drawable/bg_badge_red"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Fila de chips rapidos -->
    <HorizontalScrollView
        android:id="@+id/hsvChipsRapidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llChipsRapidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
