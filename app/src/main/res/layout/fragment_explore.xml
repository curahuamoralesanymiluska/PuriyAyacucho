<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/puriy_fondo">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/explore_title"
        style="@style/PuriyTituloPantalla" />

    <!-- Sección de Categorías Rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTemplos"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chip_temples"
                app:chipBackgroundColor="#FF3D5A"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMuseos"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chip_museums"
                app:chipBackgroundColor="#4CAF50"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGastro"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chip_food"
                app:chipBackgroundColor="#FF9800"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNaturaleza"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_nature"
                app:chipBackgroundColor="#2196F3"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHoteles"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_hotels"
                app:chipBackgroundColor="#7C4DFF"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAirbnb"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_airbnb"
                app:chipBackgroundColor="#FF5A5F"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBares"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_bars"
                app:chipBackgroundColor="#E0346E"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRecreacion"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_recreation"
                app:chipBackgroundColor="#00A693"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCafes"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_cafes"
                app:chipBackgroundColor="#8D5A3B"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <include layout="@layout/barra_filtros" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuscarAirbnb"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:text="@string/airbnb_search_more"
        android:textColor="#FF5A5F"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_airbnb"
        app:iconTint="#FF5A5F"
        app:strokeColor="#FF5A5F" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplorePlaces"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
