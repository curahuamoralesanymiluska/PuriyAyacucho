<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de destinos de la Guía: ícono de la categoría, nombre y categoría -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivDestinoIcono"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_cat_comida" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDestinoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D27"
            android:textSize="15sp"
            tools:text="Templo de San Cristóbal" />

        <TextView
            android:id="@+id/tvDestinoCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Templos"
            tools:textColor="#FF3355" />
    </LinearLayout>
</LinearLayout>
