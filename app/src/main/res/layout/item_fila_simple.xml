<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/flFilaIcono"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_modulo_icon">

            <ImageView
                android:id="@+id/ivFilaIcono"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF"
                tools:src="@drawable/ic_route" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFilaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2D2D2D"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Complejo Wari" />

            <TextView
                android:id="@+id/tvFilaDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#757575"
                android:textSize="12sp"
                tools:text="08/10/2026 · Transporte · 2 paradas" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_forward"
            app:tint="#D0D0D0" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
