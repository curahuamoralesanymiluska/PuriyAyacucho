<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCercanoImagen"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/cd_place_image"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedAll12"
        tools:src="@drawable/ph_hotel" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCercanoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#2D2D2D"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Recreo La Pampa" />

        <TextView
            android:id="@+id/tvCercanoCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            tools:text="Restaurante" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCercanoDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF3D5A"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="300 m" />

        <ImageView
            android:id="@+id/btnCercanoAgregar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_circle_pink"
            android:contentDescription="@string/route_add_stop"
            android:padding="7dp"
            android:src="@drawable/ic_agregar"
            app:tint="#FF3355" />
    </LinearLayout>
</LinearLayout>
