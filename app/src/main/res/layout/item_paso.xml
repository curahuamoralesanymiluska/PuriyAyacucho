<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Línea de tiempo -->
    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/flPasoIcono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_white">

            <ImageView
                android:id="@+id/ivPasoIcono"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF"
                tools:src="@drawable/ic_walk" />
        </FrameLayout>

        <View
            android:id="@+id/vPasoLinea"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginVertical="3dp"
            android:layout_weight="1"
            android:minHeight="22dp"
            android:background="#FFD0D8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvPasoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2D2D2D"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Camina al paradero" />

        <TextView
            android:id="@+id/tvPasoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#757575"
            android:textSize="12sp"
            tools:text="5 min · 350 m" />
    </LinearLayout>
</LinearLayout>
