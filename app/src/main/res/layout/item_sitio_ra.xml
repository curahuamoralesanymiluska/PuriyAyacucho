<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un sitio con RA: vista previa en holograma + datos + botones -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_ra_holograma">

            <com.example.puriyayacucho.ra.ReconstruccionView
                android:id="@+id/hologramaSitio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_pill_vidrio"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/ar_badge_3d"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_ar_pequeno"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/tvSitioDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_pill_vidrio"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                tools:text="a 12 km" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSitioNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1D27"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Complejo Arqueológico Wari" />

            <TextView
                android:id="@+id/tvSitioDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#6B6B7B"
                android:textSize="13.5sp"
                tools:text="La capital del primer imperio andino, con sus muros de piedra de pie otra vez." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSitioVerRA"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_view_ar"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FF3355"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/ic_ar"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSitioComoLlegar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_how_to_get"
                    android:textColor="#FF3355"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_route"
                    app:iconTint="#FF3355" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
