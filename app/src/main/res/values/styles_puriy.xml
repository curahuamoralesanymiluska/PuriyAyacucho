<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos de los módulos nuevos (Guía, RA, Boletos) -->

    <!-- Pantalla completa para la Realidad Aumentada -->
    <style name="Theme.PuriyAyacucho.Fullscreen" parent="Theme.PuriyAyacucho">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="RoundedAll12" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="GuiaSeccion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#999999</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GuiaModoBoton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sel_modo_text</item>
        <item name="backgroundTint">@color/sel_modo_bg</item>
        <item name="iconTint">@color/sel_modo_text</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="strokeColor">#E0E0E0</item>
    </style>

    <style name="GuiaSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">#2D2D2D</item>
        <item name="android:textSize">15sp</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/sel_switch_thumb</item>
        <item name="trackTint">@color/sel_switch_track</item>
    </style>

    <style name="GuiaRutaPopular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="RaBotonLateral">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="ArBotonIcono">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_circle_translucent</item>
        <item name="android:padding">12dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <style name="ArBotonTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="FilaResumen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FilaResumenLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#757575</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FilaResumenValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#4D4D4D</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BoletoDato">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BoletoDatoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#999999</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BoletoDatoValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#2D2D2D</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Píldoras "1 · Llega al sitio" de la pantalla de RA -->
    <style name="RaPasoPildora">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_pill_vidrio</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Elemento de la leyenda de colores del mapa de recorrido -->
    <style name="LeyendaRuta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#4D4D5C</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableStartCompat">@drawable/punto_leyenda</item>
    </style>

    <!-- Campos del login: gris muy claro, sin línea de abajo, borde rosa al escribir -->
    <style name="CampoLogin" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">#F5F5F9</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxStrokeColor">@color/sel_login_borde</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">#FF3355</item>
        <item name="android:textColorHint">#8A8A99</item>
        <item name="startIconTint">@color/sel_login_hint</item>
    </style>

    <style name="CampoLoginTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:textColor">#1D1D27</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Botones de Google y Facebook: blancos con borde suave -->
    <style name="BotonSocial" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#2D2D3A</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="rippleColor">#14FF3355</item>
        <item name="strokeColor">#E6E6EE</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
